<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  小汐（MascotPet）睡眠闸守卫。
  她的重启/崩溃会把机器的「禁止空闲睡眠」许可交回系统（断言跟进程走），
  实测两次都在她 ClientDied 后 5 秒机器就 Idle Sleep —— 用户看到的就是「消失 + 极卡」。
  本 job 用一个独立进程持有 caffeinate -i -s，跟她的生命周期解耦。

  OtherJobEnabled 让守卫只在「小汐这个 job 存在」时活着：
    tools/pet-control.sh off     → bootout 小汐 ⇒ 守卫自动退出，机器可以睡
    tools/pet-control.sh on      → 小汐回来 ⇒ 守卫自动回来
  所以本 plist 不需要配套改任何控制脚本。

  暂停守卫（可逆，一条命令）：launchctl bootout gui/$(id -u)/ai.hermes.mascot-pet.keepawake
  恢复：launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.hermes.mascot-pet.keepawake.plist
  改完 plist 必须 bootout + bootstrap（launchd 缓存 program spec，kickstart 不生效）。
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.hermes.mascot-pet.keepawake</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/a29285/.hermes/scripts/xiaoxi_sleep_guard.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>OtherJobEnabled</key>
		<dict>
			<key>ai.hermes.mascot-pet</key>
			<true/>
		</dict>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
