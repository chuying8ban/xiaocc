<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.hermes.xiaocc</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/a29285/ChenC/项目/xiaocc/ops/run-panel.sh</string>
		<string>top-right</string>
		<!-- 帧率：待机 12~15 是 @lead 批准的设计参数。30 帧在部署路径 9.0%、15 帧 4.9%，
		     圈速 15.0/s 与配置自洽（不是被节流），外部像素判据照过。真正把空闲压到近 0
		     要走「合成器隐式动画」那一轮，不是靠继续降帧。 -->
		<string>15</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<!-- 只在“非正常退出”时自动拉起；bootout 停掉后 launchd 不会再管它 -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<key>ThrottleInterval</key>
	<integer>10</integer>
	<!-- 为什么必须是 Interactive（别顺手删掉或换成 Adaptive —— 2026-09-29 的 A/B 实测）：
	     同一份代码、同源、同屏、fps=30，只换这个键：
	       手工前台  4.2% / 圈速 ≈30     ← 不是同一把尺子，别拿它当门槛数
	       Interactive 16.8% / 圈速 27.0 ← 现状
	       Adaptive    16.6% / 圈速 27.8 ← 不比 Interactive 便宜，白换
	       不带键      6.5% / 圈速 10.3  ← 省的是「画面真卡了」，被节流的假省电
	     Interactive 换来的是定时器按点触发（动画不卡）；烧掉的是每帧软件光栅化的钱
	     （sample 栈：CA::Layer::display_if_needed → CoreGraphics 软件光栅化）。
	     要降 CPU 得改绘制路径（静态图层点阵化缓存），不是改这个键。 -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>

	<key>StandardOutPath</key>
	<string>/Users/a29285/Library/Logs/xiaocc/panel.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/a29285/Library/Logs/xiaocc/panel.err.log</string>
</dict>
</plist>
