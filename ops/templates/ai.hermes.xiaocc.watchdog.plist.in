<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.hermes.xiaocc.watchdog</string>

	<!-- 每 5 分钟跑一次（脚本自己几秒就结束，不常驻）；面板没在跑时它什么都不做 -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>@REPO_ROOT@/ops/xiaocc_watchdog.sh</string>
	</array>

	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>

	<key>EnvironmentVariables</key>
	<dict>
		<!-- 阈值/连续次数/采样窗口做成可配置项（脚本里的默认值相同，改这里不用改代码） -->
		<key>XIAOCC_WD_THRESHOLD</key>
		<string>8</string>
		<key>XIAOCC_WD_STREAK</key>
		<string>3</string>
		<key>XIAOCC_WD_WINDOW</key>
		<string>10</string>
	</dict>

	<key>StandardOutPath</key>
	<string>@LOG_DIR@/watchdog.out.log</string>
	<key>StandardErrorPath</key>
	<string>@LOG_DIR@/watchdog.err.log</string>
</dict>
</plist>
