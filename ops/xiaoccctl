#!/bin/zsh
# 小cc 桌面面板 —— 本机运维入口（启 / 停 / 查 / 自检）
#
# 这是哪台机器上的什么：用户 Mac（1512x982），替代旧桌宠「小汐」
# （launchd label = ai.hermes.mascot-pet，已 bootout + plist 改名 .disabled，目录 ../mascot-pet 未删）。
#
# 怎么敲：
#   ops/xiaoccctl status      # 一行摘要 + 日志尾巴；运行中退出 0，未运行退出 1
#   ops/xiaoccctl start       # 幂等；plist 与仓库原件对齐后 bootstrap
#   ops/xiaoccctl stop        # bootout；本来就没跑也算成功
#   ops/xiaoccctl restart
#   ops/xiaoccctl doctor      # 自检 12 项（含「窗口是否真的在屏幕上」「自证据：圈速≈fps」）—— 人不在机器前时看这个
#   ops/xiaoccctl gate [秒]   # 判据① 60s 稳态 CPU <5%；判据② 外部「画面真在动」（连抓窗口位图比像素）
#   ops/xiaoccctl arm [秒]    # 装回去：start + 暖机 + gate，不达标/证据不全一律自动停回来
#   ops/xiaoccctl logs [err]  # 看面板日志
#
# 文件在哪：
#   plist        ~/Library/LaunchAgents/ai.hermes.xiaocc.plist（仓库原件在 ops/ 下，start 时会覆盖式同步）
#   面板日志     ~/Library/Logs/xiaocc/panel.log、panel.err.log（各自 >200KB 覆盖式轮转成 .1）
#   本脚本日志   ~/Library/Logs/xiaocc/xiaoccctl.log
#   状态落盘     ~/Library/Logs/xiaocc/state.json（doctor/status/start/stop 都会刷新）
#
# 回滚（30 秒内恢复旧桌宠，见 ops/README.md 第 4 节）：
#   ops/xiaoccctl stop
#   launchctl bootout "gui/$(id -u)/ai.hermes.mascot-pet"          # 若已 bootout 会报 not loaded，忽略
#   cp ops/baseline/ai.hermes.mascot-pet.plist.bak ~/Library/LaunchAgents/ai.hermes.mascot-pet.plist
#   launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/ai.hermes.mascot-pet.plist
#
# 静默约束：不弹任何窗（无 osascript / display dialog / alert），只走 stdout / stderr + 退出码。

emulate -L zsh
set -u

SCRIPT_DIR="${0:A:h}"
PROJECT_DIR="${SCRIPT_DIR:h}"
LABEL="${XIAOCC_LABEL:-ai.hermes.xiaocc}"
# ⚠ 下面这几个 **只给回归/沙箱用**：把 ctl 指到可抛标签上，避免验证时碰真作业、真状态文件、真留痕。
# 不做成"配置项"，是因为误设的代价不对称：指错 label = 停错东西。所以默认值必须是真作业。
OLD_LABEL="ai.hermes.mascot-pet"
GUARD_LABEL="${XIAOCC_GUARD_LABEL:-ai.hermes.mascot-pet.keepawake}"   # 睡眠闸守卫：名字留着，依赖已改成指向 xiaocc；可用环境变量接管以便沙箱验证
DOMAIN="gui/$(id -u)"
PLIST_SRC="${XIAOCC_PLIST_SRC:-$PROJECT_DIR/ops/ai.hermes.xiaocc.plist}"
PLIST_DST="${XIAOCC_PLIST:-$HOME/Library/LaunchAgents/ai.hermes.xiaocc.plist}"
LOGDIR="$HOME/Library/Logs/xiaocc"
STATE="${XIAOCC_STATE:-$LOGDIR/state.json}"
PANEL_LOG="$LOGDIR/panel.log"
PANEL_ERR="$LOGDIR/panel.err.log"
CTL_LOG="${XIAOCC_CTL_LOG:-$LOGDIR/xiaoccctl.log}"
PY="$PROJECT_DIR/.venv/bin/python"
ENTRY="$PROJECT_DIR/.venv/bin/xiaocc"
#: 判「屏上有几只面板」用的 pgrep 模式（watchdog 用同一个口径，可用环境变量接管以便沙箱测试）
INSTANCE_MATCH="${XIAOCC_INSTANCE_MATCH:-([.]venv/bin/xiaocc|-m xiaocc[.]cli) run}"

# 退出码：0 正常 / 1 未运行 / 2 用法错 / 3 没装 / 4 操作或自检失败
mkdir -p "$LOGDIR" 2>/dev/null

_rotate() {  # _rotate <file> <阈值字节>  —— 先拷到 .1，再**就地**截断（不能用 mv）
  # 为什么不能用 mv：launchd 的 StandardOutPath/StandardErrorPath 是 **O_APPEND** 打开的（用可抛标签
  # 实测：就地截断后新写入落在文件开头、不产生 NUL 空洞）。mv 只搬名字、不搬 fd 指向的 inode，
  # 所以 app 会**继续写进** $f.1，而「当前日志」永远停在轮转那一刻——看起来轮转成功，其实把活日志偷走了。
  # 代价：cp 与截断之间写进来的几行会丢；面板日志是诊断材料，不是审计账，接受。
  local f="$1" cap="${2:-200000}" sz
  [[ -f "$f" ]] || return 0
  sz=$(wc -c <"$f" 2>/dev/null | tr -d ' ')
  if [[ -n "${sz:-}" ]] && (( sz > cap )); then
    if cp -f "$f" "$f.1" 2>/dev/null; then : >"$f"; fi
  fi
  return 0
}

_log() {
  _rotate "$CTL_LOG"
  printf '%s xiaoccctl %s\n' "$(date '+%F %T')" "$*" >>"$CTL_LOG" 2>/dev/null
}

_loaded() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1 }
_pid()    { launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '/^[[:space:]]*pid = /{print $3; exit}' }
# 进程年龄：冷启动尾巴挺长（实测同一进程前 ~8 分钟 ~5%、之后 ~1.9%），不留这列就分不清
# "这版更费"和"这一拍还在暖机"。留痕里带着它，历史数字才有可比性。
_age_hms() { ps -o etime= -p "$1" 2>/dev/null | tr -d ' ' }
# 真正画下去几帧/秒（probe 的 paints_per_sec）：CPU 高企时它是 15（正常重绘）还是 30+（指纹闸被打开），
# 这一列是把「画得多」和「别处在烧」分开的唯一廉价判据。
#: 拖动态（探针的 dragging / anchor_state）——“测量窗口里发生过拖动”这件事必须能事后审计：
#: 只读“采样那一刻”的状态会漏掉窗口中间的拖动（实测一次 gate 窗口内有一次 1354px 拖动，CPU 4.8% 里混着拖动段的 14~17%）。
_is_dragging() { "$PY" -c "
import json,os
try: d=json.load(open(os.path.expanduser('~/.xiaocc/probe.json')))
except Exception: d={}
print('yes' if (d.get('dragging') is True or d.get('anchor_state') == 'drag') else 'no')" 2>/dev/null; }

#: 日志里 [t0,t1] 之间的拖动判定行数（用新边界行；只认当前格式，老裸格式行的时间列不是时间）
_drag_lines_between() {  # _drag_lines_between <HH:MM:SS> <HH:MM:SS>
  [[ -f "$PANEL_ERR" ]] || { print 0; return 0; }
  grep -E '^[0-9]{2}-[0-9]{2} ' "$PANEL_ERR" 2>/dev/null | awk -v a="$1" -v b="$2" '$2 >= a && $2 <= b && /判定=drag/ {n++} END{print n+0}'
}

_paints() { "$PY" -c "
import json,os
try: d=json.load(open(os.path.expanduser('~/.xiaocc/probe.json')))
except Exception: d={}
print(d.get('paints_per_sec'))" 2>/dev/null; }
_corner() { /usr/libexec/PlistBuddy -c 'Print :ProgramArguments:2' "$PLIST_DST" 2>/dev/null || print '?' }
_installed() { [[ -f "$PLIST_DST" ]] }

# 显示器醒睡 + 锁屏：门槛数字必须连同它一起记录 —— 屏幕睡着/锁着时 CoreAnimation 停画、
# 别的进程的窗口根本不在屏上，CPU 天然偏低、像素判据也没法判读，两臂不可比。
_display_state() {
  [[ -x "$PY" ]] || { print "未知"; return 0 }
  "$PY" - <<'PYEOF' 2>/dev/null || print "未知"
import Quartz
asleep = bool(Quartz.CGDisplayIsAsleep(Quartz.CGMainDisplayID()))
try:
    sess = Quartz.CGSessionCopyCurrentDictionary() or {}
    locked = bool(sess.get("CGSSessionScreenIsLocked"))
except Exception:
    locked = False
if asleep and locked:
    print("睡着+锁屏")
elif asleep:
    print("睡着")
elif locked:
    print("锁屏")
else:
    print("醒着")
PYEOF
}

# 稳态 CPU：两次 `ps -o time=` 做差（返回百分比字符串）。time= 超过一分钟会变 HH:MM:SS，两种都要解析。
_cpu_pct() {  # _cpu_pct <pid> <秒>
  local pid="$1" secs="${2:-60}" a b
  a=$(ps -o time= -p "$pid" 2>/dev/null | tr -d ' ')
  [[ -n "$a" ]] || { print "nan"; return 0 }
  sleep "$secs"
  b=$(ps -o time= -p "$pid" 2>/dev/null | tr -d ' ')
  "$PY" - "$a" "$b" "$secs" <<'PYEOF' 2>/dev/null || print "nan"
import sys
def secs(t):
    p = [float(x) for x in t.split(':')]
    return p[0] * 3600 + p[1] * 60 + p[2] if len(p) == 3 else p[0] * 60 + p[1]
try:
    a, b, n = secs(sys.argv[1]), secs(sys.argv[2]), float(sys.argv[3])
except Exception:
    print("nan"); raise SystemExit(0)
print(f"{100 * (b - a) / n:.1f}")
PYEOF
}

# 外部可观测的「画面真在动」：连抓 2~3 张窗口位图比字节。这是 @lead 定的第二判据 ——
# 换成「合成器驱动动画」后进程本就该睡着，拿圈速判会冤枉一条更好的实现，所以必须从外面看像素。
_motion_json() {  # _motion_json <pid> [采样数=3] [间隔秒=0.7]
  local pid="$1" samples="${2:-3}" gap="${3:-0.7}"
  [[ -x "$PY" ]] || { print '{"changed":null,"error":"no-python"}'; return 0 }
  "$PY" - "$pid" "$samples" "$gap" <<'PYEOF' 2>/dev/null || print '{"changed":null,"error":"probe-failed"}'
import json, sys, time
try:
    import Quartz
except Exception as exc:
    print(json.dumps({"changed": None, "error": f"no-quartz:{exc}"})); raise SystemExit(0)
pid, samples, gap = int(sys.argv[1]), int(sys.argv[2]), float(sys.argv[3])
opts = Quartz.kCGWindowListOptionOnScreenOnly | Quartz.kCGWindowListExcludeDesktopElements

def grab():
    infos = [w for w in Quartz.CGWindowListCopyWindowInfo(opts, Quartz.kCGNullWindowID)
             if w.get("kCGWindowOwnerPID") == pid]
    if not infos:
        return None, None
    # 一个 pid 可能有多个窗口（阴影层、状态项、离屏的巨大辅助窗…）：先在屏幕范围内的窗口里挑面积最大的那个，
    # 找不到再看全体（避免选中 30000x30000 那种必然抓不到位图的离屏窗）
    disp = dict(Quartz.CGDisplayBounds(Quartz.CGMainDisplayID()))

    def area(w):
        b = dict(w.get("kCGWindowBounds") or {})
        return b.get("Width", 0) * b.get("Height", 0)

    def on_display(w):
        b = dict(w.get("kCGWindowBounds") or {})
        return (b.get("X", 0) + b.get("Width", 0) > disp.get("X", 0)
                and b.get("X", 0) < disp.get("X", 0) + disp.get("Width", 0)
                and b.get("Y", 0) + b.get("Height", 0) > disp.get("Y", 0)
                and b.get("Y", 0) < disp.get("Y", 0) + disp.get("Height", 0))

    candidates = [w for w in infos if on_display(w)] or infos
    win = max(candidates, key=area)
    img = Quartz.CGWindowListCreateImage(
        Quartz.CGRectNull, Quartz.kCGWindowListOptionIncludingWindow,
        win["kCGWindowNumber"], Quartz.kCGWindowImageBoundsIgnoreFraming)
    if img is None:
        return None, win
    data = Quartz.CGDataProviderCopyData(Quartz.CGImageGetDataProvider(img))
    return bytes(data) if data is not None else b"", win

shots, rect = [], None
for i in range(max(2, samples)):
    blob, win = grab()
    if win is not None:
        b = dict(win.get("kCGWindowBounds") or {})
        rect = [round(b.get("X", 0)), round(b.get("Y", 0)), round(b.get("Width", 0)), round(b.get("Height", 0))]
    shots.append(blob)
    if i != max(2, samples) - 1:
        time.sleep(gap)

if any(s is None for s in shots):
    print(json.dumps({"changed": None, "error": "抓不到窗口位图", "rect": rect})); raise SystemExit(0)
best = 0.0
for a, b in zip(shots, shots[1:]):
    if len(a) != len(b) or not a:
        best = 100.0 if a != b else best
        continue
    diff = sum(1 for x, y in zip(a, b) if x != y)
    best = max(best, 100.0 * diff / len(a))
print(json.dumps({"changed": best > 0.05, "max_diff_pct": round(best, 3),
                  "shots": len(shots), "gap_s": gap, "rect": rect}))
PYEOF
}

# 窗口采样：唯一的「进程活着但看不见」硬证据。
# 输出两行：第 1 行 JSON（喂 state.json），第 2 行人话（给 doctor 显示）。
_window_json() {
  local pid="$1"
  [[ -x "$PY" ]] || { print '{"count":-1,"windows":[],"error":"no-python"}'; print "无 python，抓不到"; return 0 }
  "$PY" - "$pid" <<'PYEOF' 2>/dev/null || { print '{"count":-1,"windows":[],"error":"probe-failed"}'; print "抓取失败"; }
import json, sys
try:
    import Quartz
except Exception as exc:                       # pyobjc 缺失：如实报告，不假装
    print(json.dumps({"count": -1, "windows": [], "error": f"no-quartz:{exc}"}))
    print("无 Quartz")
    raise SystemExit(0)
pid = int(sys.argv[1])
opts = Quartz.kCGWindowListOptionOnScreenOnly | Quartz.kCGWindowListExcludeDesktopElements
infos = Quartz.CGWindowListCopyWindowInfo(opts, Quartz.kCGNullWindowID)
mine = []
for w in infos:
    if w.get("kCGWindowOwnerPID") != pid:
        continue
    b = dict(w.get("kCGWindowBounds") or {})
    mine.append({"x": round(b.get("X", 0)), "y": round(b.get("Y", 0)),
                 "w": round(b.get("Width", 0)), "h": round(b.get("Height", 0)),
                 "layer": w.get("kCGWindowLayer")})
print(json.dumps({"count": len(mine), "windows": mine}))
print("; ".join(f"{w['x']},{w['y']} {w['w']}x{w['h']} layer={w['layer']}" for w in mine) or "无窗口")
PYEOF
}

_write_state() {  # _write_state <last_error>
  local last="${1:-}" pid loaded_str win
  pid="$(_pid)"; loaded_str=false; _loaded && loaded_str=true
  win=$([[ -n "${pid:-}" ]] && _window_json "$pid" || print '{"count":null,"windows":[]}')
  win="${win%%$'\n'*}"                          # 只要第 1 行 JSON，人话那行喂给 state.json 会解析失败
  [[ -x "$PY" ]] || { print -u2 "xiaoccctl: 找不到 $PY，state.json 未更新"; return 0 }
  "$PY" - "$STATE" "$LABEL" "$PLIST_DST" "$PANEL_LOG" "$PANEL_ERR" \
        "${loaded_str}" "${pid:-}" "$(_corner)" "$last" "$win" <<'PYEOF' 2>/dev/null
import json, sys, datetime, pathlib
state, label, plist, plog, elog, loaded, pid, corner, last, win = sys.argv[1:11]
try:
    window = json.loads(win)
except Exception:
    window = {"count": None, "windows": [], "error": "unparsable"}
doc = {
    "ts": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
    "label": label,
    "installed": pathlib.Path(plist).exists(),
    "loaded": loaded == "true",
    "pid": int(pid) if pid.strip().isdigit() else None,
    "corner": corner,
    "plist": plist,
    "log": plog,
    "err_log": elog,
    "window": window,
    "last_error": last.strip() or None,
}
# 原子写：同目录唯一临时名 + os.replace（直写会在并发/中途被杀时留下半截 JSON —— 面板那边刚踩过同款抢跑）
import os as _os, tempfile as _tf
_p = pathlib.Path(state)
_fd, _tn = _tf.mkstemp(prefix=_p.name + ".", suffix=".tmp", dir=str(_p.parent))
with _os.fdopen(_fd, "w") as _fh:
    _fh.write(json.dumps(doc, ensure_ascii=False, indent=2) + "\n")
_os.replace(_tn, _p)
PYEOF
  return 0
}

# 睡眠闸守卫：**实测修正**（2026-09-29，两个可抛标签对照 + 真机断言）——
# `KeepAlive.OtherJobEnabled` 只管「启动/保持」，**不管收尾**：bootout 了它盯的那个作业之后，
# 守卫依旧在跑（+8s / +3s 两次采样 pid 不变），于是它继续持有 `PreventUserIdleSystemSleep`
# （真机实测：用户 22:20 点了「退出小cc」，caffeinate 断言从 19:03 起连续持有了 4h22m，跨过那次退出）。
# 所以必须**两头都做**：stop 时显式 bootout 守卫（见 cmd_stop），start 时再补起来（本函数）。
# 只做一半的后果分别是「机器空闲不睡、在电池上白耗」和「空闲 1 分钟就睡」——两个都不会报错。
_ensure_guard() {
  local st
  st=$(launchctl print "$DOMAIN/$GUARD_LABEL" 2>/dev/null | awk '/^[[:space:]]*state = /{print $3; exit}')
  if [[ "${st:-}" == "running" ]]; then
    print "睡眠闸守卫：运行中"
    return 0
  fi
  launchctl kickstart "$DOMAIN/$GUARD_LABEL" >/dev/null 2>&1 \
    || launchctl bootstrap "$DOMAIN" "$HOME/Library/LaunchAgents/$GUARD_LABEL.plist" >/dev/null 2>&1
  sleep 2
  st=$(launchctl print "$DOMAIN/$GUARD_LABEL" 2>/dev/null | awk '/^[[:space:]]*state = /{print $3; exit}')
  if [[ "${st:-}" == "running" ]]; then
    print "睡眠闸守卫：已补起（keepalive job 之前因 stop 停在 exited）"
    _log "start: 补起睡眠闸守卫"
    return 0
  fi
  print -u2 "xiaoccctl: 睡眠闸守卫没起来（state=${st:-unknown}）—— 机器空闲 1 分钟会睡"
  _log "start: 守卫补起失败 state=${st:-unknown}"
  return 1
}

cmd_start() {
  [[ -f "$PLIST_SRC" ]] || { print -u2 "xiaoccctl: 仓库原件不存在：$PLIST_SRC"; return 3 }
  _rotate "$PANEL_LOG"; _rotate "$PANEL_ERR"
  if _loaded && [[ -n "$(_pid)" ]]; then
    print "已在运行 (pid=$(_pid) 停靠点=$(_corner))"
    _log "start: 已在运行 pid=$(_pid)"
    _ensure_guard
    _write_state ""; return 0
  fi
  cp -f "$PLIST_SRC" "$PLIST_DST" || { print -u2 "xiaoccctl: 写 plist 失败"; return 4 }
  _loaded && launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1   # 半死状态：先清干净
  local err
  err=$(launchctl bootstrap "$DOMAIN" "$PLIST_DST" 2>&1); local rc=$?
  if (( rc != 0 )); then
    print -u2 "xiaoccctl: bootstrap 失败 (rc=$rc)：$err"
    print -u2 "--- panel.err.log 末尾 ---"
    tail -n 15 "$PANEL_ERR" 2>/dev/null | sed 's/^/| /'
    _log "start: bootstrap 失败 rc=$rc $err"
    _write_state "bootstrap 失败 rc=$rc：$err"; return 4
  fi
  local i pid=""
  for i in {1..30}; do
    pid="$(_pid)"; [[ -n "$pid" ]] && break
    sleep 0.5
  done
  if [[ -z "$pid" ]]; then
    print -u2 "xiaoccctl: 15 秒内没拿到 pid —— 面板没起来"
    tail -n 15 "$PANEL_ERR" 2>/dev/null | sed 's/^/| /'
    _log "start: 超时无 pid"
    _write_state "start 后 15 秒内没有 pid"; return 4
  fi
  print "已启动 (pid=$pid 停靠点=$(_corner))"
  _log "start: pid=$pid corner=$(_corner)"
  _ensure_guard
  _write_state ""; return 0
}

cmd_stop() {
  if ! _loaded; then
    print "本来就没在跑（$LABEL 未加载）"
    _log "stop: 未加载，无事可做"
    _write_state ""; return 0
  fi
  local pid; pid="$(_pid)"
  launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1
  local i
  for i in {1..20}; do
    _loaded || break
    sleep 0.5
  done
  if _loaded; then
    launchctl kill TERM "$DOMAIN/$LABEL" >/dev/null 2>&1
    for i in {1..6}; do _loaded || break; sleep 0.5; done
  fi
  if _loaded; then
    print -u2 "xiaoccctl: 已 bootout 但 job 仍在（pid=$(_pid)），请查 $CTL_LOG"
    _log "stop: 残留 pid=$(_pid)"
    _write_state "stop 后 job 仍在"; return 4
  fi
  # 守卫必须一起走：OtherJobEnabled 只管启动（见上面 _ensure_guard 的实测注释），
  # 不收尾的话它会继续持有 PreventUserIdleSystemSleep —— 用户以为「退出了」，机器却还在被按着不睡。
  # 幂等（没加载时什么都不做），且**不改 stop 的退出码语义**。
  if launchctl print "$DOMAIN/$GUARD_LABEL" >/dev/null 2>&1; then
    launchctl bootout "$DOMAIN/$GUARD_LABEL" >/dev/null 2>&1
    for i in {1..8}; do
      launchctl print "$DOMAIN/$GUARD_LABEL" >/dev/null 2>&1 || break
      sleep 0.25
    done
    if launchctl print "$DOMAIN/$GUARD_LABEL" >/dev/null 2>&1; then
      print -u2 "xiaoccctl: ⚠ 睡眠闸守卫仍在（$GUARD_LABEL）—— 它可能还按着「禁止空闲睡眠」"
      _log "stop: 守卫未随停（$GUARD_LABEL）"
    else
      _log "stop: 睡眠闸守卫已随停（$GUARD_LABEL）"
    fi
  fi
  print "已停止（原 pid=${pid:-?}）"
  _log "stop: 已停止 原 pid=${pid:-?}"
  _write_state ""; return 0
}

cmd_status() {
  _installed || { print "小cc: 未安装（缺 $PLIST_DST）"; return 3; }
  local pid; pid="$(_pid)"
  if _loaded && [[ -n "$pid" ]]; then
    local et; et=$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')
    print "小cc: 运行中 pid=$pid 停靠点=$(_corner) 已运行=${et:-?}"
    print "  日志: $PANEL_LOG"
  else
    print "小cc: 未运行（停靠点=$(_corner)）"
  fi
  [[ -s "$PANEL_ERR" ]] && tail -n 3 "$PANEL_ERR" | sed 's/^/  | /'
  [[ -s "$PANEL_LOG" ]] && tail -n 3 "$PANEL_LOG" | sed 's/^/  | /'
  _write_state ""
  { _loaded && [[ -n "$pid" ]] } && return 0 || return 1
}

cmd_doctor() {
  local fail=0
  print "== 小cc 自检 $(date '+%F %T') =="
  if [[ -f "$PLIST_SRC" ]] && cmp -s "$PLIST_SRC" "$PLIST_DST"; then
    print "✓ ① plist 已安装且与仓库原件一致"
  else
    print "✗ ① plist 缺失或与仓库不一致（$PLIST_DST）"; fail=1
  fi
  if [[ -x "$ENTRY" ]] && [[ -x "$PY" ]]; then
    print "✓ ② venv 入口可执行"
  else
    print "✗ ② venv 入口不可执行：$ENTRY"; fail=1
  fi
  local loaded=false; _loaded && loaded=true
  [[ "$loaded" == true ]] && print "✓ ③ label $LABEL 已加载" || { print "✗ ③ label $LABEL 未加载"; fail=1; }
  local pid; pid="$(_pid)"
  if [[ -n "$pid" ]] && ps -p "$pid" >/dev/null 2>&1; then
    print "✓ ④ 进程活着 pid=$pid"
  else
    print "✗ ④ 没有活着的进程"; fail=1
  fi
  local win count human
  if [[ -n "$pid" ]]; then
    win=$(_window_json "$pid")
    human="${win##*$'\n'}"
    win="${win%%$'\n'*}"
    count=$(print -r -- "$win" | sed -n 's/.*"count":[ ]*\([-0-9]*\).*/\1/p')
    if [[ "${count:-0}" -gt 0 ]]; then
      print "✓ ⑤ 窗口在屏幕上：${human:-?}"
    else
      print "✗ ⑤ 进程活着但抓不到窗口（count=${count:-?}）—— 屏幕上看不见"; fail=1
    fi
  else
    print "✗ ⑤ 无进程，窗口无从谈起"; fail=1
  fi
  local now mt age m
  now=$(date +%s); mt=0
  for f in "$PANEL_LOG" "$PANEL_ERR"; do
    [[ -f "$f" ]] || continue
    m=$(stat -f %m "$f" 2>/dev/null || print 0)
    (( m > mt )) && mt=$m
  done
  if (( mt > 0 )); then
    age=$(( now - mt ))
    if (( age < 900 )); then print "✓ ⑥ 日志新鲜（${age}s 前有写入；面板只在启动/异常时写，15 分钟内有动静即可）"
    else print "✗ ⑥ 日志 ${age}s 没动静（面板可能卡住）"; fail=1; fi
  else
    print "✗ ⑥ 完全没有日志文件"; fail=1
  fi
  if pmset -g assertions 2>/dev/null | grep -q 'PreventUserIdleSystemSleep  *1'; then
    print "✓ ⑦ 有人持有睡眠闸（PreventUserIdleSystemSleep=1）"
  else
    print "✗ ⑦ 没人持有睡眠闸 —— 机器空闲 1 分钟就会睡（sleep=1）"; fail=1
  fi
  if launchctl print "$DOMAIN/$OLD_LABEL" >/dev/null 2>&1; then
    print "✗ ⑧ 旧桌宠 $OLD_LABEL 还在加载（取代小汐就不该在）"; fail=1
  else
    print "✓ ⑧ 旧桌宠已停用"
  fi
  local nlines=0 m2
  for f in "$PANEL_LOG" "$PANEL_ERR"; do
    [[ -f "$f" ]] || continue
    m2=$(wc -l <"$f" 2>/dev/null | tr -d ' ')
    nlines=$(( nlines + ${m2:-0} ))
  done
  if (( nlines > 0 )); then
    print "✓ ⑨ 日志可读（共 ${nlines} 行）"
  else
    print "✗ ⑨ 日志为空 —— 面板起来了吗"; fail=1
  fi
  # ⑩ 锚点核对（位置语义）：只提示、不判死 —— 拖拽/贴边都是合法态，别把交互误报成故障
  local afile="${XIAOCC_ANCHOR_FILE:-$HOME/.xiaocc/anchor.json}" verdict pline
  if [[ ! -f "$afile" ]]; then
    print "ℹ ⑩ 还没有锚点文件（$afile）—— 没被拖动过，锚点取启动参数 $(_corner)"
  elif [[ -z "${win:-}" || "${win}" == *'"count":null'* || "${win}" == *'"count":-1'* ]]; then
    print "ℹ ⑩ 有锚点文件，但当前没有窗口可核对（面板没跑或抓不到）"
  else
    verdict=$("$PY" - "$afile" "$win" <<'PYEOF' 2>/dev/null
import json, sys
try:
    a = json.load(open(sys.argv[1])); w = json.loads(sys.argv[2])
except Exception as exc:
    print(f"读不出来：{exc}"); raise SystemExit(0)
if not w.get("windows"):
    print("没有窗口可核对（进程在但看不见）"); raise SystemExit(0)
r = w["windows"][0]
dx, dy = r["x"] - a.get("x", 0), r["y"] - a.get("y", 0)
same = "一致" if max(abs(dx), abs(dy)) <= 6 else "不一致 —— 看日志里的「位置变化」行 / probe 的 anchor_ok"
print(f"锚点 ({a.get('x'):.0f},{a.get('y'):.0f}) vs 实测 ({r['x']},{r['y']}) ⇒ Δ({dx:+.0f},{dy:+.0f}) {same}")
PYEOF
)
    print "ℹ ⑩ ${verdict}"
  fi
  # ⑪ 自证据（显示层每秒写 probe.json）：CPU 低有两种可能 —— 真的省，或者被节流了（画面其实在卡）
  local pre probe_rc
  if [[ -z "$pid" ]]; then
    print "ℹ ⑪ 面板没在跑 —— 自证据无从谈起（不吃上一次留下的旧快照）"
  else
    pre=$("$ENTRY" probe 2>&1); probe_rc=$?
    if (( probe_rc == 0 )); then
      print "✓ ⑪ 自证据：省电且没被节流（圈速 ≈ fps）"
      print -r -- "$pre" | sed -n '2,4p' | sed 's/^/    | /'
    elif (( probe_rc == 1 )); then
      # 圈速低不等于故障：动画交给合成器做时进程本就该睡着（@lead 定的新口径）。
      # 所以先看外部像素 —— 画面在动就只提示，画面静止才是真故障。
      local mo
      mo=$(_motion_json "$pid" 3 0.7)
      if [[ "$(_json_get "$mo" changed)" == "true" ]]; then
        print "ℹ ⑪ 圈速偏低但外部画面在动（合成器驱动动画的合法形态）：$(print -r -- "$mo" | sed 's/^.*"max_diff_pct": //;s/,.*//')% 字节在变"
      else
        print "✗ ⑪ 自证据不合格（圈速偏了／快照过期／进程已不在）且外部画面静止："
        print -r -- "$pre" | sed 's/^/    | /'; fail=1
      fi
    else
      print "ℹ ⑪ 没有自证据文件（面板还没跑过，或 XIAOCC_PROBE_FILE 指到了别处）"
    fi
  fi
  # ⑫ 显示器醒睡：只报事实 —— 屏幕睡着时 CoreAnimation 停画，CPU 天然偏低，不能跟醒着的臂比
  print "ℹ ⑫ 显示器：$(_display_state)"
  # ⑬ 状态年龄（@lead 采纳 @researcher 的矩阵）：**只提示、不判失败**；
  #    state_ttl_s 为 null（idle/offline 这类不过期的状态）**永远不报**，否则每只正常待机的桌宠都会被报警。
  #    容差取 +5s 而不是严格 > TTL：状态可能在引擎上次判断之后才过期，写盘周期 1s + 一拍 ≤1s，贴线会误报。
  local pa r13
  # 允许指到别处的快照（与 xiaocc CLI 的 XIAOCC_PROBE_FILE 同一约定）—— 便于用造好的快照逐档验证，不碰真文件
  pa="${XIAOCC_PROBE_FILE:-$HOME/.xiaocc/probe.json}"
  if [[ -z "$pid" ]]; then
    print "ℹ ⑬ 状态年龄：面板没在跑，跳过"
  elif [[ ! -f "$pa" ]]; then
    print "ℹ ⑬ 状态年龄：没有 probe.json（显示层太老，或面板还没跑过）"
  else
    r13=$("$PY" - "$pa" <<'PYEOF' 2>/dev/null
import json, sys, time
d = json.load(open(sys.argv[1]))
age, ttl, sat, snap, src = d.get("state_age_s"), d.get("state_ttl_s"), d.get("state_at"), d.get("at"), d.get("state_source")
if age is None:
    print("OLD", d.get("state"), "", "", "")
    raise SystemExit(0)
verdict = "OK"
if ttl is None:
    verdict = "NULL"
elif float(age) > float(ttl) + 5:
    verdict = "STALE"
if sat is not None and snap is not None and float(sat) > float(snap) + 5:
    verdict = "FUTURE"
print(verdict, f"{float(age):.1f}", "" if ttl is None else f"{float(ttl):.1f}", src or "?")
PYEOF
)
    case "${r13%% *}" in
      OLD)   print "ℹ ⑬ 状态年龄：这份 probe.json 还没有 state_age_s 字段（README §8：显示层太老，或没重启过）" ;;
      OK)    print "ℹ ⑬ 状态年龄：$(print -r -- "$r13" | awk '{print $2}')s（源 $(print -r -- "$r13" | awk '{print $4}')，保鲜期 $(print -r -- "$r13" | awk '{print $3}')s）—— 在保鲜期内" ;;
      NULL)  print "ℹ ⑬ 状态年龄：$(print -r -- "$r13" | awk '{print $2}')s，但该状态不过期（state_ttl_s=null，如 idle/offline）⇒ 按口径永不报警" ;;
      STALE) print "ℹ ⑬ 状态年龄：⚠️ 已 $(print -r -- "$r13" | awk '{print $2}')s，超过保鲜期 $(print -r -- "$r13" | awk '{print $3}')s + 5s 容差（源 $(print -r -- "$r13" | awk '{print $4}')）"
             print "   判读：可能是「源侧时间语义坏（该退档没退）」，也可能是「这个状态本来就持续这么久」——"
             print "   若面板此刻仍显示该状态、没退成 idle/offline，说明源每拍都在刷新鲜度 ⇒ 后者（见 ops/README §8 的已知语义坑）。" ;;
      FUTURE) print "ℹ ⑬ 状态年龄：⚠️ 源给的 state_at 比快照还新 5 秒以上 ⇒ 未来时间戳，该状态在可见未来内不可能过期" ;;
      *)     print "ℹ ⑬ 状态年龄：读不出来（probe.json 解析失败）" ;;
    esac
  fi
  pline=$(grep -E "位置变化|锚点已更新|窗口漂移" "$PANEL_ERR" 2>/dev/null | tail -1)
  [[ -n "$pline" ]] && print "ℹ   最近位移留痕：${pline}"

  (( fail == 0 )) && print "== 全部通过 ==" || print "== 有失败项（见上面 ✗）=="
  _write_state "$([[ $fail == 0 ]] && print '' || print 'doctor 有失败项')"
  (( fail == 0 )) && return 0 || return 4
}

cmd_logs() {
  if [[ "${1:-}" == "err" ]]; then tail -n 40 "$PANEL_ERR"; else tail -n 40 "$PANEL_LOG"; fi
  return 0
}

_json_get() { print -r -- "$1" | sed -n "s/.*\"$2\": *\([^,}]*\).*/\1/p" | head -1 | tr -d ' '; }

# 门槛测量（@lead 定的）：判据① CPU < 5%；判据② **外部可观测的画面真在动**（像素在变），
# 外加一条反忙等护栏（圈速远超 fps = 又退回空转）。圈速不再是硬判据 —— 动画若交给合成器做，
# 进程本就该睡着，拿圈速判会冤枉一条更好的实现。
cmd_gate() {
  local secs="${1:-60}" pid cpu disp cpu_line t0 t1 dwin probe_out probe_rc motion m_changed m_pct astate loops fps busy cpu_ok=0 motion_ok=0 note="" inst other
  _installed || { print -u2 "xiaoccctl: 没安装（$PLIST_DST）"; return 3; }
  pid="$(_pid)"
  if [[ -z "$pid" ]]; then
    print "✗ 面板没在跑（job 未加载）。先 start，再门禁；没有进程可量。"
    return 4
  fi
  # 前置：只认**单实例**（pgrep 实数）。手工 `--linger` 起的臂对 launchctl 完全隐形（实测有一个
  # 白烧 3.5h / 9.6%，watchdog 一行都没记），而判据②取的是「相交显示区的最大窗口」——真有第二只在屏上，
  # 量的可能不是受管那只。前置不满足时**不判门槛、也不停面板**，单独用退出码 6 表示「环境不对」。
  inst=$({ pgrep -f "$INSTANCE_MATCH" 2>/dev/null || true; } | grep -c .)
  if [[ "$inst" != "1" ]]; then
    other=$({ pgrep -f "$INSTANCE_MATCH" 2>/dev/null || true; } | grep -v "^${pid}$" | tr '\n' ' ')
    print "✗ 前置不满足：屏上有 ${inst} 个实例（受管 pid=${pid}；另有 ${other:-无}）"
    print "   门禁只认单实例：多出来的那只既可能白烧 CPU，也会让判据②量错窗口。先清掉再测（不清也不停面板）。"
    _log "gate: 前置不满足 屏上 ${inst} 个实例（受管 pid=${pid}，另有 ${other:-无}）"
    return 6
  fi

  # 注：这里本该有「光标停在桌宠上 ⇒ 不判门槛」的前置，**撤回了** —— 判据（probe 的
  # ignores_mouse_events）实测在 CPU 5.1% 时仍为 True，不可靠。跑 gate 前请手动把鼠标移开桌宠。
  disp="$(_display_state)"
  # 判据①**按显示状态分档**（@lead 2026-09-29 定）：屏醒未锁 ≤7%（本轮基线 5.4~5.7%）；屏睡/锁屏 ≤5%（史线不动）。
  # 同一面板两种状态的读数差 1~2 个百分点（实测：A 版屏睡 3.5~4.6% / 屏醒 5.4~5.7%），拿屏睡线去判屏醒读数
  # 会把一个还在正常带宽里的面板判死。档位与线一起进留痕。
  if [[ "$disp" == "醒着" ]]; then cpu_line=7.0; else cpu_line=5.0; fi
  print "== 门槛测量：${secs}s 稳态 CPU + 外部画面判据 / 显示状态：${disp}（判据①线 <${cpu_line}%）=="
  if [[ "$(_is_dragging)" == "yes" ]]; then
    print "✗ 前置不满足：桌宠正处于拖动态（读数里混着拖动段的 14~17%）—— 松手后再测"
    _log "gate: 前置不满足 测量前已在拖动态"
    return 6
  fi
  t0=$(date '+%H:%M:%S')
  cpu=$(_cpu_pct "$pid" "$secs")
  t1=$(date '+%H:%M:%S')
  dwin="$(_drag_lines_between "$t0" "$t1")"
  if [[ "${dwin:-0}" != "0" ]] || [[ "$(_is_dragging)" == "yes" ]]; then
    print "✗ 前置不满足：测量窗口 ${t0}–${t1} 内发生过拖动（日志命中 判定=drag ${dwin} 条）——"
    print "   这一窗的 CPU 含拖动段（实测 14~17%），不是稳态；松手、鼠标移开桌宠后重跑。不停面板（退出码 6）。"
    _log "gate: 前置不满足 窗口内拖动 dwin=${dwin} 窗口=${t0}-${t1}"
    return 6
  fi
  print "  A) CPU：${cpu}%（门槛 <${cpu_line}%，档=${disp}，进程年龄=$(_age_hms "$pid")，paints/s=$(_paints)，窗口 ${t0}–${t1} 无拖动）"

  probe_out=$("$ENTRY" probe 2>&1); probe_rc=$?
  motion=$(_motion_json "$pid" 3 0.7)
  m_changed=$(_json_get "$motion" changed)
  m_pct=$(_json_get "$motion" max_diff_pct)
  astate=$(print -r -- "$probe_out" | sed -n 's/.*关系=\([a-z_]*\).*/\1/p')
  if [[ "$astate" == "collapsed" ]]; then
    motion_ok=1; note="贴边收起态 —— 像素判据不适用（合法交互态，本次跳过）"
  elif [[ "$m_changed" == "true" ]]; then
    motion_ok=1; note="画面在动（1.4 秒内连续帧差异 ${m_pct}% 字节；显示状态=$disp）"
  elif [[ "$m_changed" == "false" && "$disp" == "醒着" ]]; then
    note="画面静止（最大差异 ${m_pct:-?}% 字节）—— 便宜可能是卡了"
  elif [[ "$m_changed" == "false" ]]; then
    # 屏幕睡着时 CoreAnimation 停画，此时抓到的「静止」不算证据（实测：锁屏但屏亮时能抓到、且确实在动）
    motion_ok=-1; note="不可判读（抓到的是静止画面，但显示状态=$disp —— 屏睡停画属正常，不能据此判故障）"
  else
    # changed 为 null = 抓不到位图（权限／窗口不在屏上）。判不了就别说人家静止。
    motion_ok=-1; note="不可判读（位图抓不到：$(print -r -- "$motion" | sed -n 's/.*"error": *"\([^"]*\)".*/\1/p')）"
  fi
  print "  B) 外部画面：${note}"
  print "  自证据（补充材料，非硬判据）："
  print -r -- "$probe_out" | sed 's/^/    | /'

  loops=$(print -r -- "$probe_out" | sed -n 's/.*圈速=\([0-9.]*\)\/s.*/\1/p')
  fps=$(print -r -- "$probe_out" | sed -n 's/.*fps=\([0-9.]*\).*/\1/p')
  busy=0
  if [[ -n "$loops" && -n "$fps" ]]; then
    busy=$("$PY" -c "print(1 if float('${loops}') > 2.0 * float('${fps}') else 0)" 2>/dev/null || print 0)
  fi
  [[ "$("$PY" -c "print(1 if float('${cpu}') < float('${cpu_line}') else 0)" 2>/dev/null)" == "1" ]] && cpu_ok=1

  if (( cpu_ok == 1 && motion_ok == 1 && busy == 0 )); then
    print "== 门槛通过：CPU ${cpu}% <${cpu_line}%（档=${disp}）且画面真在动 =="
    _log "gate: 通过 cpu=${cpu}% 线=${cpu_line}% 档=${disp} 年龄=$(_age_hms "$pid") motion=${m_changed}(${m_pct}%) 圈速=${loops:-?}"
    return 0
  fi
  if (( motion_ok == -1 )); then
    print "== 门槛不可判读 ==（CPU ${cpu}% 达标=${cpu_ok}，但判据②没能验：显示状态 $disp）"
    print "   显示状态不是「醒着」时像素判据可能判不了（屏睡停画）；屏幕醒着且解锁时重跑：ops/xiaoccctl gate ${secs}"
    print "   或明确接受「只验 CPU」并留痕：ops/xiaoccctl arm ${secs} --skip-motion"
    _log "gate: 不可判读 cpu=${cpu}% 显示=${disp}"
    return 5
  fi
  print "== 门槛不通过 ==（CPU ${cpu}% 对线 ${cpu_line}% 达标=${cpu_ok}、画面在动=${motion_ok}、忙等护栏=${busy}）"
  (( busy == 1 )) && print "  ⚠️ 圈速 ${loops}/s 远超 fps ${fps} —— 又退回忙等，别用 CPU 数字掩盖它"
  _log "gate: 不通过 cpu=${cpu}% 线=${cpu_line}% 档=${disp} 年龄=$(_age_hms "$pid") motion=${m_changed}(${m_pct}%) 圈速=${loops:-?} busy=${busy}"
  return 4
}

# 装回去：start → 暖机 15s（冷启动不计）→ 门禁。**不达标立刻停回去**，不留一个白烧电的进程。
# `--skip-motion`：屏幕睡着/锁着时判据②没法判读，明确接受「只验 CPU」才放行，并写进日志留痕。
cmd_arm() {
  local secs=60 skip_motion=0 rc=0 a
  for a in "$@"; do
    case "$a" in
      --skip-motion) skip_motion=1 ;;
      <->) secs="$a" ;;
    esac
  done
  cmd_start || return 4
  print "暖机 15 秒（冷启动那段不算进入门槛）…"
  sleep 15
  cmd_gate "$secs"; rc=$?
  if (( rc == 0 )); then
    print "★ 门槛通过，面板留在运行状态"
    return 0
  fi
  if (( rc == 5 )); then
    if (( skip_motion == 1 )); then
      print "⚠️ 判据②不可判读，但给了 --skip-motion ⇒ 视为通过并留痕（恢复屏幕后请补跑 gate）"
      # 欠账标记：屏幕醒着时由 ai.hermes.xiaocc.reverify 一次性任务补跑完整 gate，通过后删掉本文件。
      # 注意：disp/cpu 是 cmd_gate 的 local，这里必须自己取一份（踩过：直接引用会 "parameter not set" 中断函数）。
      local d p c
      d="$(_display_state)"; p="$(_pid)"; c="$(_cpu_pct "$p" 3)"
      "$PY" -c "import json,os,sys,time;json.dump({'ts':time.strftime('%FT%T%z'),'action':'arm-skip-motion','reason':'判据②不可判读（显示状态：'+sys.argv[1]+'）','cpu_pct':sys.argv[2],'pid':int(sys.argv[3]),'clear_by':'ai.hermes.xiaocc.reverify（屏亮补验）'},open(os.path.expanduser('~/Library/Logs/xiaocc/skip-motion.json'),'w'),ensure_ascii=False,indent=2)" "$d" "${c:-nan}" "${p:-0}"
      _log "arm: --skip-motion 放行（判据②不可判读，欠账标记已写 skip-motion.json）"
      return 0
    fi
    print -u2 "✗ 证据不全 ⇒ 停回去（判据②没能验）。屏幕醒着时重跑 arm，或 arm $secs --skip-motion 明确只验 CPU。"
    cmd_stop
    return 5
  fi
  if (( rc == 6 )); then
    print -u2 "✗ 前置不满足（屏上不是单实例）⇒ **不停面板**：停掉受管那只只会把多余的那只留下当宠物。清掉多余的实例再 arm。"
    return 6
  fi
  print -u2 "✗ 门槛不达标 ⇒ 立刻停回去（不让笔记本白烧电）；修好再 arm"
  cmd_stop
  return 4
}

case "${1:-status}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_stop || exit 4; cmd_start ;;
  status)  cmd_status ;;
  doctor)  cmd_doctor ;;
  gate)    shift; cmd_gate "${1:-60}" ;;
  arm)     shift; cmd_arm "$@" ;;
  motion)  shift; pid="${1:-}"; [[ -n "$pid" ]] || { print -u2 "用法: xiaoccctl motion <pid>"; exit 2; }; out=$(_motion_json "$pid" 3 0.7); print -r -- "$out" | tail -1; print -r -- "$out" | head -1 ;;
  logs)    shift; cmd_logs "${1:-}" ;;
  -h|--help|help)
    print "用法: xiaoccctl {status|start|stop|restart|doctor|gate [秒]|arm [秒] [--skip-motion]|logs [err]}"
    print "  gate/arm：判据① 60s 稳态 CPU <5%；判据② 外部可观测的「画面真在动」（连抓窗口位图比像素）"
    print "           屏幕睡着/锁屏时判据②不可判读 ⇒ gate 退出 5、arm 停回去（--skip-motion 才明确只验 CPU）"
    print "退出码: 0 正常 / 1 未运行 / 2 用法错 / 3 没装 / 4 门槛不达标或操作失败 / 5 证据不全（不可判读）"
    print "        / 6 前置不满足（屏上不是单实例）—— 不判门槛、不停面板"
    ;;
  *)
    print -u2 "xiaoccctl: 不认得的子命令 '$1'"
    print -u2 "用法: xiaoccctl {status|start|stop|restart|doctor|logs [err]}"
    exit 2 ;;
esac
