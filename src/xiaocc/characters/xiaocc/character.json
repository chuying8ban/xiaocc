{
  "id": "xiaocc",
  "name": "小cc",
  "version": "0.1.0",
  "author": "ChenC",
  "license": "MIT",
  "canvas": { "width": 132, "height": 140 },
  "default_scale": 1.0,
  "palette": {
    "body": "#EEF1F7",
    "shade": "#C9D2E2",
    "ink": "#26303F",
    "accent": "#6FD3E8",
    "glow": "#6FD3E8"
  },
  "states": {
    "idle": {
      "motion": "float",
      "accent": "#6FD3E8",
      "caption": "待命"
    },
    "thinking": {
      "motion": "ponder",
      "accent": "#8FA7FF",
      "caption": "思考中"
    },
    "working": {
      "motion": "busy",
      "accent": "#FFC24B",
      "caption": "干活中"
    },
    "waiting": {
      "motion": "beckon",
      "accent": "#FF8A5B",
      "caption": "等你确认"
    },
    "done": {
      "motion": "cheer",
      "accent": "#5BD08A",
      "caption": "搞定"
    },
    "error": {
      "motion": "wobble",
      "accent": "#F2665E",
      "caption": "出错了"
    },
    "offline": {
      "motion": "sleep",
      "accent": "#9AA1B1",
      "caption": "离线"
    }
  },
  "assets": {
    "idle": "assets/idle.svg",
    "thinking": "assets/thinking.svg",
    "working": "assets/working.svg",
    "waiting": "assets/waiting.svg",
    "done": "assets/done.svg",
    "error": "assets/error.svg",
    "offline": "assets/offline.svg"
  }
}
